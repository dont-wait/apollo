APP_NAME="Apollo Blog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apollo
DB_USERNAME=apollo
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
PHPMYADMIN_PORT=8080

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=rustfs

# Local-only RustFS credentials; Laravel runs on the host.
RUSTFS_IMAGE=rustfs/rustfs@sha256:41fe89380f4120a337790c02af192c3fe7bb55c3edc2e6e9357b487b47c6ab21
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=apollo-media
RUSTFS_ENDPOINT=http://127.0.0.1:9000
RUSTFS_URL=http://127.0.0.1:9000/apollo-media
QUEUE_CONNECTION=database

SCOUT_DRIVER=meilisearch
SCOUT_PREFIX=apollo_
SCOUT_QUEUE=true
TOXIC_WORDS_ENABLED=true
MEILISEARCH_HOST=http://127.0.0.1:7700
# Local-only key; use a generated secret in production.
MEILISEARCH_KEY=apollo-local-search-key
MEILISEARCH_PORT=7700

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
ENABLE_MOCK_OTP=true
MOCK_OTP=666666

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AI_WEEKLY_MODEL=qwen2.5:7b
AI_WEEKLY_MODEL_URL=http://127.0.0.1:11435/v1/chat/completions
AI_WEEKLY_MODEL_KEY=
AI_WEEKLY_AUTHOR_ID=
AI_WEEKLY_MODEL_TIMEOUT=600
AI_WEEKLY_TEMPERATURE=0
AI_WEEKLY_ANALYSIS_INPUT_CHARS=6000
AI_WEEKLY_ANALYSIS_OUTPUT_TOKENS=1000
AI_WEEKLY_REVIEW_OUTPUT_TOKENS=1800
AI_WEEKLY_GENERIC_API_TOKEN=
OLLAMA_PORT=11435
OLLAMA_CPUS=6
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_KEEP_ALIVE=1m
